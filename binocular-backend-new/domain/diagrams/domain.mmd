classDiagram
    direction TB

%% Technical Inheritance & Base Classes
    class AbstractDomainObject {
        +Iid iid
        +Key uniqueKey
    }

    class Stakeholder {
        +String name
        +String email
    }

    class Reference {
        +ReferenceCategory category
        +RepositoryId repositoryId
    }

%% High-Level Organizations
    class Project {
        +String name
        +String description
        +MutableSet~AccountId~ accountIds
        +MutableSet~IssueId~ issueIds
        +MutableSet~MergeRequestId~ mergeRequestIds
        +MutableSet~MilestoneId~ milestoneIds
    }

    class Repository {
        +String localPath
        +ProjectId projectId
    }

%% VCS Technical Domain
    class Commit {
        +String sha
        +Signature authorSignature
        +Signature committerSignature
        +Stats stats
        +String message
        +RepositoryId repositoryId
        +MutableSet~String~ parentShas
        +MutableSet~String~ childShas
        +List~BuildId~ buildIds
        +List~FileId~ fileIds
        +List~ModuleId~ moduleIds
        +List~IssueId~ issueIds
    }

    class Signature {
        +DeveloperId developerId
        +LocalDateTime timestamp
    }

    class Branch {
        +String name
        +String fullName
        +ReferenceCategory category
        +String headSha
        +RepositoryId repositoryId
        +MutableSet~FileId~ fileIds
    }

    class Developer {
        +String name
        +String email
        +String gitSignature
        +RepositoryId repositoryId
        +MutableSet~IssueId~ issueIds
        +MutableSet~FileId~ fileIds
        +MutableSet~String~ authoredCommitShas
        +MutableSet~String~ committedCommitShas
    }

    class Remote {
        +String name
        +String url
        +RepositoryId repositoryId
    }

%% ITS (Issue Tracking) Domain
    class Issue {
        +String gid
        +Int platformIid
        +String title
        +String description
        +LocalDateTime createdAt
        +LocalDateTime closedAt
        +LocalDateTime updatedAt
        +String state
        +String webUrl
        +List~Mention~ mentions
        +ProjectId project
        +AccountId authorId
        +Set~AccountId~ accountIds
        +Set~CommitId~ commitIds
        +Set~MilestoneId~ milestoneIds
        +Set~NoteId~ noteIds
        +Set~DeveloperId~ developerIds
    }

    class Mention {
        +String commit
        +LocalDateTime createdAt
        +Boolean closes
    }

    class MergeRequest {
        +ProjectId project
        +Int platformIid
        +String title
        +String description
        +String createdAt
        +String closedAt
        +String updatedAt
        +String state
        +String webUrl
        +List~Mention~ mentions
        +MutableSet~MilestoneId~ milestoneIds
        +MutableSet~NoteId~ noteIds
        +MutableSet~AccountId~ accountIds
    }

    class Account {
        +String gid
        +Platform platform
        +String login
        +String name
        +String avatarUrl
        +String url
        +MutableSet~ProjectId~ projectIds
        +MutableSet~IssueId~ issueIds
        +MutableSet~MergeRequestId~ mergeRequestIds
        +MutableSet~NoteId~ noteIds
    }

    class Milestone {
        +ProjectId project
        +Int platformIid
        +String title
        +String description
        +String state
        +String createdAt
        +String updatedAt
        +String startDate
        +String dueDate
        +Boolean expired
        +String webUrl
        +MutableSet~IssueId~ issueIds
        +MutableSet~MergeRequestId~ mergeRequestIds
    }

    class Note {
        +String body
        +String createdAt
        +String updatedAt
        +Boolean system
        +Boolean resolvable
        +Boolean confidential
        +Boolean internal
        +Boolean imported
        +String importedFrom
        +MutableSet~IssueId~ issueIds
        +MutableSet~MergeRequestId~ mergeRequestIds
        +MutableSet~AccountId~ accountIds
    }

%% Type Definitions & Enums
    class Platform {
        <<enumeration>>
        GitHub
        GitLab
    }

    class ReferenceCategory {
        <<enumeration>>
        LOCAL_BRANCH
        REMOTE_BRANCH
        TAG
        NOTE
        PSEUDO_REF
        UNKNOWN
        MAIN_PSEUDO_REF
        MAIN_REF
        LINKED_PSEUDO_REF
        LINKED_REF
        BISECT
        REWRITTEN
        WORKTREE_PRIVATE
    }

    class StatsKind {
        <<enumeration>>
        ADDITION
        DELETION
        MODIFICATION
    }

    class Stats {
        +Long additions
        +Long deletions
        +StatsKind kind
    }

%% CI/CD & Structure Domain
    class Build {
        +String status
        +List~JobId~ jobIds
        +List~CommitId~ commitIds
    }

    class Job {
        +String name
        +String status
    }

    class Module {
        +String path
        +List~Commit~ commits
        +List~File~ files
        +List~Module~ childModules
        +List~Module~ parentModules
    }

    class File {
        +String path
    }

    class Revision {
        +String content
        +CommitId commitId
        +FileId fileId
    }

    class User {
        <<deprecated>>
        +String name
        +String email
        +RepositoryId repositoryId
        +MutableSet~IssueId~ issueIds
        +MutableSet~FileId~ fileIds
    }

%% Relationships
    AbstractDomainObject <|-- Project
    AbstractDomainObject <|-- Repository
    AbstractDomainObject <|-- Commit
    AbstractDomainObject <|-- Remote
    AbstractDomainObject <|-- Issue
    AbstractDomainObject <|-- MergeRequest
    AbstractDomainObject <|-- Account
    AbstractDomainObject <|-- Milestone
    AbstractDomainObject <|-- Note
    AbstractDomainObject <|-- Build
    AbstractDomainObject <|-- Module
    AbstractDomainObject <|-- File
    AbstractDomainObject <|-- Revision

    AbstractDomainObject <|-- Reference
    Reference <|-- Branch

    AbstractDomainObject <|-- Stakeholder
    Stakeholder <|-- Developer
    Stakeholder <|-- User

    Project "1" -- "0..1" Repository : has (via ID)
    Project "1" -- "*" Issue : contains (via ID)
    Project "1" -- "*" MergeRequest : contains (via ID)
    Project "1" -- "*" Account : contains (via ID)
    Repository "1" -- "*" Commit : owns (via ID)
    Repository "1" -- "*" Branch : owns (via ID)
    Repository "1" -- "*" Developer : involves (via ID)
    Repository "1" -- "*" Remote : references (via ID)

    Commit "1" *-- "0..1" Stats : describes
    Commit "1" -- "1" Signature : author
    Commit "1" -- "0..1" Signature : committer
    Signature "*" -- "1" Developer : belongs to (via ID)
    
    Commit "0..*" -- "0..*" Commit : parents/children (via SHA)
    Commit "1" -- "*" Revision : includes (via ID)
    Commit "*" -- "*" Build : triggers (via ID)
    Commit "*" -- "*" Issue : references (via ID)
    
    Issue "1" -- "1" Account : authored by (via ID)
    Issue "1" -- "*" Note : has (via ID)
    Issue "1" -- "*" Mention : has
    Issue "*" -- "*" Milestone : belongs to (via ID)
    Issue "*" -- "*" Account : involves (via ID)
    
    MergeRequest "1" -- "*" Note : has (via ID)
    MergeRequest "1" -- "*" Mention : has
    MergeRequest "*" -- "*" Milestone : targets (via ID)
    
    Module "1" -- "*" File : contains (direct/ID)
    Module "1" -- "*" Module : submodules (direct/ID)
    File "1" -- "*" Revision : history (via ID)
    Build "1" -- "*" Job : executes (via ID)
