classDiagram
    direction TB

    class Project {
        +Id iid
        +String name
        +String description
        +Repository repo
        +MutableSet~Issue~ issues
        +MutableSet~Account~ accounts
        +MutableSet~MergeRequest~ mergeRequests
    }

    class Repository {
        +Id iid
        +String localPath
        +Project project
    }

    class Issue {
        +Id iid
        +String title
        +String description
        +Account author
        +MutableSet~Account~ accounts
        +MutableList~Commit~ commits
        +List~Milestone~ milestones
        +List~Note~ notes
        +List~Mention~ mentions
        +List~User~ users
    }

    class MergeRequest {
        +Id iid
        +String title
        +String description
        +String createdAt
        +String closedAt
        +String updatedAt
        +Project project
        +MutableList~Account~ accounts
        +List~Milestone~ milestones
        +List~Note~ notes
        +List~Mention~ mentions
    }

    class Note {
        +Id iid
        +String body
        +String createdAt
        +Boolean system
        +Boolean resolvable
        +Boolean confidential
        +Boolean internal
    }

    class User {
        <<deprecated>>
        +String name
        +String email
        +Repository repository
        +MutableSet~Issue~ issues
    }

    class Mention {
        +String commit
        +LocalDateTime createdAt
        +Boolean closes
        +Account actor
    }

    Project "1" -- "0..1" Repository : scopes
    Project "1" -- "*" Issue : contains
    Project "1" -- "*" MergeRequest : contains
    Project "1" -- "*" Account : contains
    Issue "1" -- "1" Account : authored by
    Issue "1" -- "*" Note : has
    Issue "1" -- "*" Mention : has
    Issue "*" -- "*" Account : involves
    MergeRequest "1" -- "*" Note : has
    MergeRequest "1" -- "*" Mention : has
    Repository "1" -- "*" User : legacy
