@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix schema:  <https://schema.org/> .

# SEON terms must be written as full IRIs because names contain "::", "+", "()", etc.

#################################################################
# Baseline (root BranchExport) -> CMPO::Baseline
#################################################################

<https://schemas.inso-world.com/shapes#BranchExportShape>
    a sh:NodeShape ;
    sh:targetClass <https://dev.nemo.inf.ufes.br/seon/SEON.owl#CMPO::Baseline> ;
    sh:severity sh:Violation ;

    sh:property [
          sh:path rdfs:label ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:string ;
          sh:message "The exported branch is missing its name, or the branch name appears more than once."@en
    ] ;

    sh:property [
          sh:path dcterms:identifier ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:string ;
          sh:pattern "^[0-9a-fA-F]{40}$" ;
          sh:message "The export contains an invalid commit SHA. Expected a 40-character hexadecimal Git commit ID."@en
      ] ;

    sh:property [
          sh:path dcterms:description ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:string ;
          sh:message "The export is missing the commit message for the selected branch snapshot."@en
      ] ;

    sh:property [
          sh:path dcterms:description ;
          sh:minLength 10 ;
          sh:datatype xsd:string ;
          sh:severity sh:Warning ;
          sh:message "The commit message is very short. A more descriptive message would make the export easier to understand."@en
      ] ;

    sh:property [
          sh:path schema:identifier ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:string ;
          sh:message "The export is missing the internal commit identifier."@en
      ] ;

    sh:property [
          sh:path prov:wasAssociatedWith ;
          sh:minCount 1 ;
          sh:nodeKind sh:IRI ;
          sh:class <https://dev.nemo.inf.ufes.br/seon/SEON.owl#CPO::Programmer> ;
          sh:message "The export is missing a valid reference to the committer. A linked programmer entry is required here."@en
      ] ;

    sh:property [
          sh:path prov:wasInformedBy ;
          sh:nodeKind sh:IRI ;
          sh:class <https://dev.nemo.inf.ufes.br/seon/SEON.owl#CMPO::Checkin> ;
          sh:message "One of the linked parent or related commits is invalid. Commit references must point to exported commit nodes."@en
      ] ;

    sh:property [
          sh:path <https://dev.nemo.inf.ufes.br/seon/SEON.owl#packages.Baseline+Version> ;
          sh:minCount 1 ;
          sh:nodeKind sh:IRI ;
          sh:class <https://dev.nemo.inf.ufes.br/seon/SEON.owl#CMPO::Version> ;
          sh:message "The export is missing links to the exported file versions. At least one file version must be included."@en
      ] .

#################################################################
# Checkin (ChildCommitDetail) -> CMPO::Checkin
#################################################################

<https://schemas.inso-world.com/shapes#CheckinShape>
    a sh:NodeShape ;
    sh:targetClass <https://dev.nemo.inf.ufes.br/seon/SEON.owl#CMPO::Checkin> ;
    sh:severity sh:Violation ;

    sh:property [
          sh:path dcterms:identifier ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:string ;
          sh:pattern "^[0-9a-fA-F]{40}$" ;
          sh:message "A child commit contains an invalid SHA. Expected a 40-character hexadecimal Git commit ID."@en
      ] ;

    sh:property [
          sh:path dcterms:description ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:string ;
          sh:message "A child commit is missing its commit message."@en
      ] ;

    sh:property [
          sh:path schema:identifier ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:string ;
          sh:message "A child commit is missing its internal commit identifier."@en
      ] ;

    sh:property [
          sh:path prov:wasAssociatedWith ;
          sh:minCount 1 ;
          sh:nodeKind sh:IRI ;
          sh:class <https://dev.nemo.inf.ufes.br/seon/SEON.owl#CPO::Programmer> ;
          sh:message "A child commit is missing a valid reference to its committer."@en
      ] .

#################################################################
# Programmer -> CPO::Programmer
#################################################################

<https://schemas.inso-world.com/shapes#ProgrammerShape>
    a sh:NodeShape ;
    sh:targetClass <https://dev.nemo.inf.ufes.br/seon/SEON.owl#CPO::Programmer> ;
    sh:severity sh:Violation ;

    sh:property [
          sh:path schema:identifier ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:string ;
          sh:message "A programmer entry is missing its identifier."@en
      ] .

#################################################################
# Artifact_CI (FileContent) -> CMPO::Artifact_CI
#################################################################

<https://schemas.inso-world.com/shapes#ArtifactShape>
    a sh:NodeShape ;
    sh:targetClass <https://dev.nemo.inf.ufes.br/seon/SEON.owl#CMPO::Artifact_CI> ;
    sh:severity sh:Violation ;

    sh:property [
          sh:path dcterms:identifier ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:string ;
          sh:message "A file entry is missing its file path."@en
      ] ;

    sh:property [
          sh:path <https://dev.nemo.inf.ufes.br/seon/SEON.owl#has.Configuration_Item_(CI)+Version> ;
          sh:minCount 1 ;
          sh:nodeKind sh:IRI ;
          sh:class <https://dev.nemo.inf.ufes.br/seon/SEON.owl#CMPO::Version> ;
          sh:message "A file entry is missing its link to the exported file content or version."@en
      ] .

#################################################################
# Version (Content) -> CMPO::Version
#################################################################

<https://schemas.inso-world.com/shapes#VersionShape>
    a sh:NodeShape ;
    sh:targetClass <https://dev.nemo.inf.ufes.br/seon/SEON.owl#CMPO::Version> ;
    sh:severity sh:Violation ;

    sh:property [
          sh:path dcterms:identifier ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:string ;
          sh:message "A file content entry is missing its blob identifier."@en
      ] ;

    sh:property [
          sh:path prov:value ;
          sh:minCount 1 ;
          sh:datatype xsd:string ;
          sh:message "A file content entry is missing its content value. If content is intentionally omitted, an omission marker must still be present."@en
      ] .
