@prefix sh:        <http://www.w3.org/ns/shacl#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix binocular: <https://data.inso-world.com/ontology/binocular#> .

binocular:BranchExport
    a rdfs:Class .

binocular:ChildCommitDetail
    a rdfs:Class .

binocular:FileContent
    a rdfs:Class .

binocular:Content
    a rdfs:Class .

binocular:BranchExportShape
    a              sh:NodeShape ;
    sh:targetClass binocular:BranchExport ;
    sh:severity    sh:Violation ;

    sh:property    [ sh:path     binocular:branch ;
                     sh:name     "Branch Name" ;
                     sh:minCount 1 ;
                     sh:maxCount 1 ;
                     sh:datatype xsd:string ;
                     sh:message   "Branch name is required and must be a string."@en ] ;

    sh:property    [ sh:path     binocular:commitSHA ;
                     sh:name     "Latest Commit SHA" ;
                     sh:minCount 1 ;
                     sh:maxCount 1 ;
                     sh:datatype xsd:string ;
                     sh:pattern  "^[0-9a-fA-F]{40}$" ;
                     sh:message   "Latest commit SHA must be a 40-character hex string."@en ] ;

    sh:property    [ sh:path     binocular:commitMessage ;
                     sh:minCount 1 ;
                     sh:maxCount 1 ;
                     sh:datatype xsd:string ;
                     sh:message   "Commit message is missing or invalid."@en ] ;

    sh:property    [ sh:path     binocular:commitMessage ;
                     sh:minLength 10 ;
                     sh:severity sh:Warning ;
                     sh:datatype xsd:string ;
                     sh:message  "Best Practice: Commit messages should be at least 10 characters long to be descriptive."@en ] ;

    sh:property    [ sh:path     binocular:wasAttributedTo ;
                     sh:datatype xsd:string ;
                     sh:minCount 1 ;
                     sh:maxCount 1 ;
                     sh:message   "The committer ID (wasAttributedTo) is required."@en ] ;

    sh:property    [ sh:path     binocular:commitId ;
                     sh:minCount 1 ;
                     sh:maxCount 1 ;
                     sh:datatype xsd:string ;
                     sh:message   "Internal commit ID is missing."@en] ;

    sh:property    [ sh:path     binocular:hasChildCommits ;
                     sh:minCount 1 ;
                     sh:nodeKind sh:IRI ;
                     sh:node     binocular:ChildCommitDetailShape ;
                     sh:message  "Child commits must be referenced as IRIs and conform to ChildCommitDetailShape."@en ] ;
    sh:property    [ sh:path     binocular:fileContents ;
                     sh:name     "Commit Content Snapshot" ;
                     sh:minCount 1 ;
                     sh:message "The export is missing the file snapshot list (fileContents)."@en ;

                     sh:property [ sh:path     binocular:filePath ;
                                   sh:minCount 1 ;
                                   sh:datatype xsd:string ;
                                   sh:message "File path is missing for an entry in the snapshot."@en ] ;
                     sh:property [ sh:path     binocular:fileContentData ;
                                   sh:minCount 1 ;
                                   sh:message "File entry is missing its content container."@en ;
                                   sh:property [ sh:path     binocular:blobId ;
                                                 sh:minCount 1 ;
                                                 sh:message "Git Blob ID (id) is missing. Check context mapping for binocular:blobId."@en ] ;
                                   sh:property [ sh:path     binocular:fileContentData ;
                                                 sh:minCount 1 ;
                                                 sh:datatype xsd:string ;
                                                 sh:message "The actual file content string is missing."@en ;
                                               ] ] ] .

binocular:ChildCommitDetailShape
    a              sh:NodeShape ;
    sh:targetClass binocular:ChildCommitDetail ;
    sh:property    [ sh:path     binocular:wasAttributedTo ;
                     sh:minCount 1 ;
                     sh:maxCount 1 ;
                     sh:datatype xsd:string ;
                     sh:message "Child commit is missing a committer attribution."@en ] .

binocular:FileContentExportShape
    a           sh:NodeShape ;
    sh:severity sh:Violation ;

    sh:property [ sh:path     binocular:filePath ;
                  sh:minCount 1 ;
                  sh:maxCount 1 ;
                  sh:datatype xsd:string ;
                  sh:message   "Individual file export missing its path."@en ] ;
    sh:property [
                    sh:path     binocular:fileContentData ;
                    sh:node     binocular:ContentShape ;
                    sh:minCount 1 ;
                    sh:message   "Individual file export missing its content data."@en ] .

binocular:ContentShape
    a           sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:property [

                    sh:path     binocular:blobId ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:datatype xsd:string ;
                    sh:message   "Content object missing required Blob ID."@en] ;
    sh:property [
                    sh:path     binocular:fileContentData ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:datatype xsd:string ;
                    sh:message   "Content object missing raw text data."@en] .
