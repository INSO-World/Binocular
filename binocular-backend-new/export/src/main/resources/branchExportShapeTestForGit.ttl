@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix binocular: <https://data.inso-world.com/ontology/binocular#> .

binocular:BranchExport a rdfs:Class .
binocular:ChildCommitDetail a rdfs:Class .

binocular:BranchExportShape
    a sh:NodeShape ;
    sh:targetClass binocular:BranchExport ;
    sh:severity sh:Violation ;

    sh:property [
          sh:path binocular:branch ;
          sh:name "Branch Name" ;
          sh:description "BranchExport must have a branchName." ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:string
      ] ;

    sh:property [
        sh:path binocular:commitSHA ;
        sh:name "Latest Commit SHA" ;
        sh:description "BranchExport must have a unique commit SHA." ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9a-fA-F]{40}$" ;
    ] ;

    sh:property [
        sh:path binocular:commitMessage ;
        sh:name "Commit Message" ;
        sh:description "Message of this commit" ;
        sh:minCount 1;
        sh:maxCount 1;
        sh:datatype xsd:string
    ] ;

    sh:property  [
        sh:path binocular:wasAttributedTo ;
        sh:name "Commiter" ;
        sh:description "The user that commited" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path binocular:commitId ;
        sh:name "CommitID" ;
        sh:description "The ID of the commit" ;
        sh:minCount 1;
        sh:maxCount 1;
        sh:datatype xsd:string
    ] ;

    sh:property [
          sh:path binocular:hasChildCommits ;
          sh:name "Child Commits List" ;
          sh:description "The list of childrenCommits must be present and non-empty." ;
          sh:minCount 1 ;
          sh:node binocular:ChildCommitDetailShape ;
      ] ;

    sh:property [
        sh:path binocular:fileContents ;
        sh:name "Commit Content Snapshot" ;
        sh:description "The commit must be linked to a list of file content states." ;
        sh:minCount 1 ;
        sh:node binocular:FileContentExportShape ;
    ] .

binocular:ChildCommitDetailShape
    a sh:NodeShape ;
    sh:targetClass binocular:ChildCommitDetail ;

    sh:property [
          sh:path binocular:wasAttributedTo ;
          sh:name "Committer ID" ;
          sh:description "ChildCommitDetail must contain the committerId." ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:string
      ] .

binocular:FileContentExportShape
    a sh:NodeShape ;
    sh:targetClass binocular:FileContent ;
    sh:severity sh:Violation ;

    sh:property [
          sh:path binocular:filePath ;
          sh:name "File Path" ;
          sh:description "The full path of the file (required for Tree reconstruction)." ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:string ;
          sh:pattern "^[^/\\s].*[^/\\s]$"
      ] ;

    sh:property [
          sh:path binocular:fileContentData ;
          sh:name "File Content Data" ;
          sh:description "The file content must be present for any file that isn't a deletion." ;
          sh:datatype xsd:string
      ] .
