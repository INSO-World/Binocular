{
  "@context": {
    "@version": 1.1,

    "seon": "https://dev.nemo.inf.ufes.br/seon/SEON.owl#",
    "prov": "http://www.w3.org/ns/prov#",
    "dcterms": "http://purl.org/dc/terms/",
    "schema": "https://schema.org/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "BranchExport": "seon:CMPO::Baseline",
    "ChildCommitDetail": "seon:CMPO::Checkin",
    "FileContent": "seon:CMPO::Artifact_CI",
    "Content": "seon:CMPO::Version",
    "Programmer": "seon:CPO::Programmer",

    "_section": "schema:description",
    "branchName": "rdfs:label",
    "commitSha": "dcterms:identifier",
    "message": "dcterms:description",
    "commitId": "schema:identifier",
    "committerId": {
      "@id": "prov:wasAssociatedWith",
      "@type": "@id"
    },
    "programmerId": "schema:identifier",
    "childrenCommits": {
      "@id": "prov:wasInformedBy",
      "@type": "@id",
      "@container": "@set"
    },
    "fileContents": {
      "@id": "seon:packages.Baseline+Version",
      "@type": "@id",
      "@container": "@set"
    },
    "filePath": "dcterms:identifier",
    "content": {
      "@id": "seon:has.Configuration_Item_(CI)+Version",
      "@type": "@id",
      "@container": "@set"
    },
    "id": "dcterms:identifier",
    "contentText": {
      "@id": "prov:value",
      "@type": "xsd:string"
    }
  }
}
